# Copy to .env for running outside Docker. docker compose sets its own values.
# Every integration below is optional; leave a value empty to switch it off.

# --- core ------------------------------------------------------------------
ENVIRONMENT=development          # staging|production require SECRET_KEY and enable HTTPS-only cookies
DEBUG=True
SECRET_KEY=                      # empty is fine in development
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://dev_user:dev_password@localhost:5432/dev_database
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
PASSWORD_RESET_URL_BASE=http://localhost:5173
LOG_LEVEL=INFO

# --- language model --------------------------------------------------------
# demo: canned answers, no network. null: features report themselves off.
# openai: needs OPENAI_API_KEY (also chosen automatically when the key is set).
LLM_PROVIDER=demo
OPENAI_API_KEY=
LLM_MODEL=gpt-4
LLM_MODEL_OVERRIDES={}
LEASE_MAX_CHUNKS=12
REGULATION_SOURCES=curated,llm
REGULATION_CACHE_TTL=86400

# --- AirDNA (spreadsheet pricing) ----------------------------------------------
AIRDNA_URL=
AIRDNA_API_KEY=

# --- Cloudinary (lease document storage) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ClickUp (approved properties pushed to a board) -----------------------
CLICKUP_URL=                     # e.g. https://api.clickup.com/api/v2/list/{list_id}/task
LIST_ID=
TEAM_ID=
ACCESS_TOKEN=
ZILLOW_CUSTOM_ID=
PROPERTY_STATUS_CUSTOM_ID=
APPROVED=
CLICKUP_OPTION_REJECTED=
CLICKUP_OPTION_CALL_BACK=
CLICKUP_OPTION_OWNER_APPROVAL=
CLICKUP_OPTION_ON_HOLD=
CLICKUP_OPTION_SEE_NOTES=
CLICKUP_OPTION_FOR_CHI_ONLY=
